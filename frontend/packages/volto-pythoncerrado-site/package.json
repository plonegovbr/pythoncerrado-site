    "release-major-alpha": "release-it major --preRelease=alpha",
    "release-alpha": "release-it --preRelease=alpha"
  },
  "addons": [
    "@eeacms/volto-matomo",
    "@simplesconsultoria/volto-videos",
    "@plone-collective/volto-image-editor",
    "@plone/volto-form-block",
    "@plone-collective/volto-techevent",
    "@simplesconsultoria/volto-light-theme"
  ],
  "theme": "@kitconcept/volto-light-theme",
  "dependencies": {
    "@eeacms/volto-matomo": "7.0.1",
    "@fontsource/outfit": "5.3.0",
    "@kitconcept/volto-light-theme": "8.0.0",
    "@plone-collective/volto-techevent": "1.0.0-beta.3",
    "@plone/components": "workspace:*",
    "@plone-collective/volto-image-editor": "1.0.1",
    "@plone/volto-form-block": "1.0.0-alpha.3",
    "@simplesconsultoria/volto-light-theme": "1.0.0-alpha.11",
    "@simplesconsultoria/volto-videos": "1.0.0-alpha.3"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@plone/registry": "workspace:*",
    "@plone/scripts": "workspace:*",
    "@plone/types": "workspace:*",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.7.3",
    "@testing-library/react": "^16.2.0",
    "release-it": "^19.0.5",
    "vitest": "^3.1.2"
  }
