{
  "name": "volto-pythoncerrado-site",
  "version": "20261013.1.0",
  "description": "Site da Python Cerrado",
  "main": "src/index.ts",
  "license": "MIT",
  "keywords": [
    "volto-addon",
    "volto",
    "plone",
    "react"
  ],
  "author": "PloneGov-BR",
  "homepage": "https://github.com/plonegovbr/pythoncerrado-site#readme",
  "repository": {
    "type": "git",
    "url": "git@github.com:plonegovbr/pythoncerrado-site"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "i18n": "rm -rf build/messages && NODE_ENV=production i18n --addon",
    "dry-release": "release-it --dry-run",
